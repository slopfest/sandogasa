# CentOS Hyperscale SIG repos, for fedrq queries
# (`-b hs.el9` / `-b hs.el10`; see ../centos-hyperscale.toml).
# Installed to /etc/fedrq/repos/ or ~/.config/fedrq/repos/.
#
# Repo ids, names and metalinks match what centos-release-hyperscale
# and its flavor subpackages install in /etc/yum.repos.d/, so on a real
# Hyperscale machine these definitions coincide with the system's. Two
# deliberate differences: `$stream` is a CentOS-only dnf variable, so
# the metalinks spell it `$releasever-stream` (fedrq sets $releasever
# from the branch); and gpgkey points at distribution-gpg-keys, which
# exists on machines that never installed the release package.
#
# Flavors are per-stream: main, experimental, facebook, spin exist on
# both 9 and 10; hotfixes and intel on 9 only; kernel and asahi on 10
# only. Enabling a flavor on a stream that lacks it fails on metadata.
# Testing repos live on buildlogs.centos.org and are not defined here.

[centos-hyperscale]
name=CentOS Stream $releasever - Hyperscale
metalink=https://mirrors.centos.org/metalink?repo=centos-hyperscale-sig-packages-main-$releasever-stream&arch=$basearch&protocol=https,http
#baseurl=https://mirror.stream.centos.org/SIGs/$releasever-stream/hyperscale/$basearch/packages-main/
gpgkey=file:///usr/share/distribution-gpg-keys/centos/RPM-GPG-KEY-CentOS-SIG-HyperScale
gpgcheck=1
repo_gpgcheck=0
priority=50
enabled=0

[centos-hyperscale-source]
name=CentOS Stream $releasever - Hyperscale - Source
metalink=https://mirrors.centos.org/metalink?repo=centos-hyperscale-sig-packages-main-source-$releasever-stream&arch=source&protocol=https,http
#baseurl=https://mirror.stream.centos.org/SIGs/$releasever-stream/hyperscale/source/packages-main/
gpgkey=file:///usr/share/distribution-gpg-keys/centos/RPM-GPG-KEY-CentOS-SIG-HyperScale
gpgcheck=1
repo_gpgcheck=0
priority=50
enabled=0

