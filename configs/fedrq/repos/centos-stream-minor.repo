# CentOS Stream plus the EPEL minor that builds against it (`-b c10.4s`;
# see ../centos-stream-minor.toml). CentOS Stream URLs use
# $releasever_major, the EPEL ones $releasever (`10.4`), whose
# `epel-10.N` metalinks MirrorManager answers for every minor, unlike
# the `epel-z-10.N` fedrq's own epel.repo asks for.

[stream-minor-baseos]
name=CentOS Stream $releasever_major - BaseOS
metalink=https://mirrors.centos.org/metalink?repo=centos-baseos-$releasever_major-stream&arch=$basearch
gpgkey=file:///usr/share/distribution-gpg-keys/centos/RPM-GPG-KEY-CentOS-Official
gpgcheck=1
repo_gpgcheck=0
enabled=0

[stream-minor-baseos-source]
name=CentOS Stream $releasever_major - BaseOS - Source
metalink=https://mirrors.centos.org/metalink?repo=centos-baseos-source-$releasever_major-stream&arch=source
gpgkey=file:///usr/share/distribution-gpg-keys/centos/RPM-GPG-KEY-CentOS-Official
gpgcheck=1
repo_gpgcheck=0
enabled=0

[stream-minor-appstream]
name=CentOS Stream $releasever_major - AppStream
metalink=https://mirrors.centos.org/metalink?repo=centos-appstream-$releasever_major-stream&arch=$basearch
gpgkey=file:///usr/share/distribution-gpg-keys/centos/RPM-GPG-KEY-CentOS-Official
gpgcheck=1
repo_gpgcheck=0
enabled=0

[stream-minor-appstream-source]
name=CentOS Stream $releasever_major - AppStream - Source
metalink=https://mirrors.centos.org/metalink?repo=centos-appstream-source-$releasever_major-stream&arch=source
gpgkey=file:///usr/share/distribution-gpg-keys/centos/RPM-GPG-KEY-CentOS-Official
gpgcheck=1
repo_gpgcheck=0
enabled=0

[stream-minor-crb]
name=CentOS Stream $releasever_major - CRB
metalink=https://mirrors.centos.org/metalink?repo=centos-crb-$releasever_major-stream&arch=$basearch
gpgkey=file:///usr/share/distribution-gpg-keys/centos/RPM-GPG-KEY-CentOS-Official
gpgcheck=1
repo_gpgcheck=0
enabled=0

[stream-minor-crb-source]
name=CentOS Stream $releasever_major - CRB - Source
metalink=https://mirrors.centos.org/metalink?repo=centos-crb-source-$releasever_major-stream&arch=source
gpgkey=file:///usr/share/distribution-gpg-keys/centos/RPM-GPG-KEY-CentOS-Official
gpgcheck=1
repo_gpgcheck=0
enabled=0

[epel-minor]
name=EPEL $releasever - Everything
metalink=https://mirrors.fedoraproject.org/metalink?repo=epel-$releasever&arch=$basearch
gpgkey=file:///usr/share/distribution-gpg-keys/epel/RPM-GPG-KEY-EPEL-$releasever_major
gpgcheck=1
repo_gpgcheck=0
enabled=0

[epel-minor-source]
name=EPEL $releasever - Everything - Source
metalink=https://mirrors.fedoraproject.org/metalink?repo=epel-source-$releasever&arch=source
gpgkey=file:///usr/share/distribution-gpg-keys/epel/RPM-GPG-KEY-EPEL-$releasever_major
gpgcheck=1
repo_gpgcheck=0
enabled=0

[epel-minor-testing]
name=EPEL $releasever - Testing
metalink=https://mirrors.fedoraproject.org/metalink?repo=epel-testing-$releasever&arch=$basearch
gpgkey=file:///usr/share/distribution-gpg-keys/epel/RPM-GPG-KEY-EPEL-$releasever_major
gpgcheck=1
repo_gpgcheck=0
enabled=0

[epel-minor-testing-source]
name=EPEL $releasever - Testing - Source
metalink=https://mirrors.fedoraproject.org/metalink?repo=epel-testing-source-$releasever&arch=source
gpgkey=file:///usr/share/distribution-gpg-keys/epel/RPM-GPG-KEY-EPEL-$releasever_major
gpgcheck=1
repo_gpgcheck=0
enabled=0
