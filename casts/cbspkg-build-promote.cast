[0.00141, "o", "\u001b]0;cbspkg build --varia ~/s/c/h/r/rasdaemon\u0007\u001b[m\r"]
[0.876853, "o", "\r\n\u001b[1m» Find the commit to build, and check CentOS/Hyperscale/rpms/rasdaemon has it\u001b[0m\r\n    \u001b[90m$\u001b[0m \u001b[1m\u001b[32mgit rev-parse c10s-hs\u001b[0m\r\n    \u001b[90m$\u001b[0m \u001b[1m\u001b[32mgit fetch origin\u001b[0m\r\n"]
[1.639079, "o", "[cbspkg] checking the CBS login (koji --profile cbs moshimoshi)\r\n"]
[1.363833, "o", "\r\n\u001b[1m» Check rasdaemon.spec's Release against its %changelog and stock CentOS Stream\u001b[0m\r\n    \u001b[90m$\u001b[0m \u001b[1m\u001b[32mgit worktree add --quiet --detach /tmp/.tmp7EyJFx/tree bfcb36bf04ccdc904a0ae188179ee716714a68ba\u001b[0m\r\n"]
[0.006248, "o", "    \u001b[90m$\u001b[0m \u001b[1m\u001b[32mkoji -p cbs call --json-output getBuildConfig hyperscale10s-packages-main-el10s-build\u001b[0m\r\n    \u001b[90m$\u001b[0m \u001b[1m\u001b[32mkoji -p cbs call --json-output getBuildConfig hyperscale10s-packages-facebook-el10s-build\u001b[0m\r\n    \u001b[90m$\u001b[0m \u001b[1m\u001b[32mfedrq pkgs -b c10s --src -F line:name,epoch,version,release rasdaemon\u001b[0m\r\n"]
[0.97739, "o", "    \u001b[90m$\u001b[0m \u001b[1m\u001b[32mrpmspec -q --srpm --qf '%|epoch?{%{epoch}}:{0}|:%{version}-%{release}\\n%{changelogname}\\n' --undefine fedora --define '_include_frame_pointers 1' --define 'centos 10' --define 'centos_hs 1' --define 'centos_ver 10' --define 'dist .hs.el10' --define 'el10 1' --define 'rhel 10' --define 'vendor CentOS Hyperscale SIG' --define '_sourcedir /tmp/.tmp7EyJFx/tree' /tmp/.tmp7EyJFx/tree/rasdaemon.spec\u001b[0m\r\n"]
[0.017323, "o", "    \u001b[90m$\u001b[0m \u001b[1m\u001b[32mrpmspec -q --srpm --qf '%{version}-%{release}\\n' --undefine fedora --define '_include_frame_pointers 1' --define 'centos 10' --define 'centos_hs 1' --define 'centos_ver 10' --define 'el10 1' --define 'rhel 10' --define 'vendor CentOS Hyperscale SIG' --define '_sourcedir /tmp/.tmp7EyJFx/tree' --define 'dist %{nil}' /tmp/.tmp7EyJFx/tree/rasdaemon.spec\u001b[0m\r\n"]
[0.011977, "o", "    \u001b[90m$\u001b[0m \u001b[1m\u001b[32mrpmspec -q --srpm --qf '%|epoch?{%{epoch}}:{0}|:%{version}-%{release}\\n%{changelogname}\\n' --undefine fedora --define '_include_frame_pointers 1' --define 'centos 10' --define 'centos_hs 1' --define 'centos_ver 10' --define 'dist .hs+fb.el10' --define 'el10 1' --define 'facebook 1' --define 'rhel 10' --define 'vendor CentOS Hyperscale SIG' --define '_sourcedir /tmp/.tmp7EyJFx/tree' /tmp/.tmp7EyJFx/tree/rasdaemon.spec\u001b[0m\r\n"]
[0.026473, "o", "\r\n\u001b[1m» Check which of rasdaemon's sources the SIG lookaside has\u001b[0m\r\n    \u001b[90m$\u001b[0m \u001b[1m\u001b[32mcurl --head --fail https://git.centos.org/sources/rasdaemon/rasdaemon-1.0.0.tar.xz/sha512/e32259b5b40f1474a19cf6c11a66a0f1083c161d8de86cb3b385bd58375444aa2d753f2e9cfd268ad385ab1b7e9a29e58fa6bc97dec4b1d6ccbd80c18cf3aa1b/rasdaemon-1.0.0.tar.xz\u001b[0m\r\n"]
[0.351198, "o", "rasdaemon's sources are in the SIG lookaside already.\r\n\r\n\u001b[1m» Check which of hyperscale10s-packages-main and hyperscale10s-packages-facebook's tags list rasdaemon already\u001b[0m\r\n    \u001b[90m$\u001b[0m \u001b[1m\u001b[32mcbs list-pkgs --tag hyperscale10s-packages-main-candidate --package rasdaemon\u001b[0m\r\n"]
[0.769345, "o", "    \u001b[90m$\u001b[0m \u001b[1m\u001b[32mcbs list-pkgs --tag hyperscale10s-packages-main-testing --package rasdaemon\u001b[0m\r\n"]
[0.782727, "o", "    \u001b[90m$\u001b[0m \u001b[1m\u001b[32mcbs list-pkgs --tag hyperscale10s-packages-main-release --package rasdaemon\u001b[0m\r\n"]
[0.729254, "o", "    \u001b[90m$\u001b[0m \u001b[1m\u001b[32mcbs list-pkgs --tag hyperscale10s-packages-facebook-candidate --package rasdaemon\u001b[0m\r\n"]
[0.747999, "o", "    \u001b[90m$\u001b[0m \u001b[1m\u001b[32mcbs list-pkgs --tag hyperscale10s-packages-facebook-testing --package rasdaemon\u001b[0m\r\n"]
[0.722267, "o", "    \u001b[90m$\u001b[0m \u001b[1m\u001b[32mcbs list-pkgs --tag hyperscale10s-packages-facebook-release --package rasdaemon\u001b[0m\r\n"]
[0.737511, "o", "rasdaemon is listed in every tag it builds through already.\r\n"]
[0.01808, "o", "\r\n\u001b[1m» Find the tracking issue to update, through GitLab's API\u001b[0m\r\n"]
[0.8635, "o", "\r\n\u001b[1mrasdaemon c10s-hs at bfcb36bf04cc:\u001b[0m\r\n  \u001b[1m\u001b[32mcbs build --nowait hyperscale10s-packages-main-el10s 'git+https://gitlab.com/CentOS/Hyperscale/rpms/rasdaemon.git#bfcb36bf04ccdc904a0ae188179ee716714a68ba'\u001b[0m\r\n  \u001b[1m\u001b[32mcbs build --nowait hyperscale10s-packages-facebook-el10s 'git+https://gitlab.com/CentOS/Hyperscale/rpms/rasdaemon.git#bfcb36bf04ccdc904a0ae188179ee716714a68ba'\u001b[0m\r\n  \u001b[1m\u001b[32mcbs watch-task '<tasks>'\u001b[0m\r\n\u001b[1mThen comment on https://gitlab.com/CentOS/Hyperscale/rpms/rasdaemon/-/work_items/1:\u001b[0m\r\n  \u001b[90m>\u001b[0m `<the build in hyperscale10s-packages-main>` is built: tagged into `hyperscale10s-packages-main-candidate`.\r\n  \u001b[90m>\u001b[0m \r\n  \u001b[90m> <!-- sandogasa: <the build in hyperscale10s-packages-main> reached candidate -->\u001b[0m\r\n\u001b[1mThen comment on https://gitlab.com/CentOS/Hyperscale/rpms/rasdaemon/-/work_items/1:\u001b[0m\r\n  \u001b[90m>\u001b[0m `<the build in hyperscale10s-packages-facebook>` is built: tagged into `hyperscale10s-packages-facebook-candidate`.\r\n  \u001b[90m>\u001b[0m \r\n  \u001b[90m> <!-- sandogasa: <the build in hyperscale10s-packages-facebook> reached candidate -->\u001b[0m\r\nStart a build? [Y/n]: "]
[1.085221, "o", "\r\n"]
[0.000129, "o", "\r\n\u001b[1m» Start a build of rasdaemon in hyperscale10s-packages-main-el10s, which puts it in hyperscale10s-packages-main-candidate\u001b[0m\r\n"]
[1.1e-05, "o", "    \u001b[90m$\u001b[0m \u001b[1m\u001b[32mcbs build --nowait hyperscale10s-packages-main-el10s 'git+https://gitlab.com/CentOS/Hyperscale/rpms/rasdaemon.git#bfcb36bf04ccdc904a0ae188179ee716714a68ba'\u001b[0m\r\n    [Enter to run, Ctrl-C to abort] "]
