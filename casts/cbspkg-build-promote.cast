[0.731789, "o", "\r\n\u001b[1m» Find older builds of rasdaemon the promoted ones replace\u001b[0m\r\n    \u001b[90m$\u001b[0m \u001b[1m\u001b[32mkoji --profile cbs list-tagged hyperscale10s-packages-main-testing rasdaemon\u001b[0m\r\n    \u001b[90m$\u001b[0m \u001b[1m\u001b[32mkoji --profile cbs list-tagged hyperscale10s-packages-facebook-testing rasdaemon\u001b[0m\r\n"]
