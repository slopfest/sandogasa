[0.015745, "o", "\u001b]0;~/s/c/h/r/rasdaemon\u0007\u001b[m\u001b]11;?\u001b\\\u001b[6n\u001b[0c\u001b[?2004h\u001b[?2031h\u001b[>4;1m\u001b=\u001b[K\u001b]133;A;click_events=1\u0007\u001b[J\r\n\u001b[K\u001b[1;36mrasdaemon\u001b[0m on \u001b[1;35m c10s-hs\u001b[0m \r\n\u001b[1;2;31m⬢ [fedora-packaging]\u001b[0m \u001b[1;32m❯\u001b[0m \u001b]133;B\u0007\u001b[K\r\u001b[23C"]
